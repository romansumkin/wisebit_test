{
  "name": "wisebit_test",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API tests for demoqa.com (test assignment, parts A and B)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:parallel": "playwright test --workers=4 --repeat-each=3",
    "test:api:parallel": "playwright test --project=api --workers=4 --repeat-each=3",
    "ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "docker:test": "docker compose run --rm --build tests",
    "docker:test:ui": "docker compose run --rm --build tests npx playwright test --project=ui",
    "docker:test:api": "docker compose run --rm --build tests npx playwright test --project=api",
    "docker:report": "docker compose --profile report up --build report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@api-clients/*": ["./api-clients/*"],
      "@asserts/*": ["./asserts/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@pages/*": ["./pages/*"],
      "@steps/*": ["./steps/*"],
      "@test-data/*": ["./test-data/*"]
    }
  },
  "include": [
    "api-clients",
    "asserts",
    "fixtures",
    "pages",
    "steps",
    "test-data",
    "tests",
    "playwright.config.ts"
  ]
}
